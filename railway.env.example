# Railway all-in-one — operator env file TEMPLATE.
#
# Copy this to railway.env (gitignored), fill in real values, then run:
#   RAILWAY_ENV_FILE=./railway.env scripts/deploy-railway-allinone.sh
#
# Format: one KEY=value per line. '#' lines and blanks are ignored. A leading
# 'export ' is stripped. Surrounding single/double quotes on a value are removed.
# The deploy script sets each line as a Railway SERVICE VARIABLE. NEVER commit
# the filled-in railway.env — it carries the inference + onion secrets.
#
# Full reference for every key: docs/railway-env.md.

# --- REQUIRED: remote inference (residents have no brain without these) -----
INFERENCE_BASE_URL=        # e.g. https://openrouter.ai/api  (never localhost)
INFERENCE_API_KEY=         # bearer key for the inference endpoint
INFERENCE_MODEL=           # e.g. anthropic/claude-3.5-haiku

# --- Volume / paths — every runtime write lands on /data --------------------
DATA_ROOT=/data
NULLCITY_MEMORY_ROOT=/data/controller/memory

# --- Dashboard serving + in-container wiring --------------------------------
DASHBOARD_HOST=0.0.0.0
AGENT_GATEWAY_URL=ws://127.0.0.1:43595
NULLCITY_RS_HOST=127.0.0.1:43594

# --- Recommended security + launch posture ----------------------------------
CONTROLLER_INSTANCE_ID=nullcity-allinone
CONTROLLER_CITY_HTTP_TOKEN=        # generate: openssl rand -hex 32
NULLCITY_CITY_API_TOKEN=           # generate: openssl rand -hex 32 (BFF -> city API)
AGENT_GATEWAY_AUTH_TOKEN=          # optional (loopback is tokenless); openssl rand -hex 32
CONTROLLER_ENABLE_AP_GP_EXCHANGE=false

# --- Landing / auth (public HTTPS) ------------------------------------------
LANDING_SESSION_MODE=api
LANDING_AUTH_BASE_URL=https://oniondao.dev
AUTH_COOKIE_NAME=session
AUTH_COOKIE_DOMAIN=.oniondao.dev
CITY_PUBLIC_BASE_URL=https://city.oniondao.dev

# --- Onions (secrets shared out-of-band — DO NOT commit real values) --------
ONION_API_BASE_URL=https://oniondao.dev
ONION_EXTERNAL_API_KEY=__SHARED_SECRET__
ONION_CALLBACK_SECRET=__SHARED_SECRET__

# --- Optional: persistent city DB (else in-memory resets on redeploy) -------
# CITY_DATABASE_URL=

# Build-args (DASHBOARD_REPO / DASHBOARD_REF) are passed via the deploy
# script's own env, NOT this file — see docs/railway-deploy-for-dev.md.
