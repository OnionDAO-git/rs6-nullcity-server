{
    "name": "@runejs/server",
    "version": "1.0.0-alpha.3",
    "description": "A RuneScape game server emulator written in TypeScript.",
    "main": "dist/index.js",
    "scripts": {
        "start": "npm run build && concurrently \"npm run build:watch\" \"npm run start:infra\" \"npm run start:game\"",
        "start:game": "nodemon --config nodemon.json --delay 5000ms --max-old-space-size=4096 dist/server/runner.js -- -game",
        "start:game:supervised": "bash scripts/runtime/start-game-supervised.sh",
        "start:game:dev": "npm run build && concurrently \"npm run build:watch\" \"npm run start:game\"",
        "start:login": "node --max-old-space-size=1024 dist/server/runner.js -- -login",
        "start:update": "node --max-old-space-size=1024 dist/server/runner.js -- -update",
        "start:infra": "concurrently \"npm run start:update\" \"npm run start:login\"",
        "start:standalone": "concurrently \"npm run start:infra\" \"npm run start:game\"",
        "game": "npm run start:game",
        "game:dev": "npm run start:game:dev",
        "login": "npm run start:login",
        "update": "npm run start:update",
        "infra": "npm run start:infra",
        "standalone": "npm run start:standalone",
        "controller": "npm run build && node dist/controller/index.js",
        "controller:once": "npm run build && node dist/controller/index.js --once",
        "controller:dev": "ts-node -r tsconfig-paths/register src/controller/index.ts",
        "controller:bench": "npm run build && node dist/controller/benchmarks/cli.js",
        "benchmark:report": "ts-node -r tsconfig-paths/register src/controller/benchmarks/report.ts",
        "controller:ensure-inventory": "ts-node -r tsconfig-paths/register src/controller/admin/ensure-inventory.ts",
        "controller:revive": "ts-node -r tsconfig-paths/register src/controller/admin/revive-cli.ts",
        "resident:nudge": "ts-node -r tsconfig-paths/register src/controller/admin/resident-nudge.ts",
        "resident:goal-edit": "ts-node -r tsconfig-paths/register src/controller/admin/resident-goal-edit.ts",
        "controller:trade-soak": "ts-node -r tsconfig-paths/register src/controller/admin/named-trade-soak.ts",
        "controller:equip-soak": "ts-node -r tsconfig-paths/register src/controller/admin/named-equip-soak.ts",
        "controller:combat-soak": "ts-node -r tsconfig-paths/register src/controller/admin/named-combat-soak.ts",
        "controller:memory-recall-soak": "ts-node -r tsconfig-paths/register src/controller/admin/named-memory-recall-soak.ts",
        "controller:normal-life-audit": "ts-node -r tsconfig-paths/register src/controller/admin/normal-life-audit.ts",
        "controller:inference-audit": "ts-node -r tsconfig-paths/register src/controller/admin/inference-health-audit.ts",
        "controller:status": "ts-node -r tsconfig-paths/register src/controller/admin/status-cli.ts",
        "controller:smoke": "ts-node -r tsconfig-paths/register src/controller/admin/live-smoke.ts",
        "inference:canary": "ts-node -r tsconfig-paths/register src/controller/admin/inference-canary-smoke.ts",
        "patron:smoke": "ts-node -r tsconfig-paths/register src/controller/admin/patron-loop-smoke.ts",
        "patron:grant": "ts-node -r tsconfig-paths/register src/controller/patron/cli.ts --grant",
        "patron:offer": "ts-node -r tsconfig-paths/register src/controller/patron/cli.ts --offer",
        "patron:ask": "ts-node -r tsconfig-paths/register src/controller/patron/cli.ts --ask",
        "patron:witness": "ts-node -r tsconfig-paths/register src/controller/patron/cli.ts --witness",
        "patron:gift": "ts-node -r tsconfig-paths/register src/controller/patron/cli.ts --gift",
        "patron:register": "ts-node -r tsconfig-paths/register src/controller/patron/cli.ts --register",
        "patron:checkin": "ts-node -r tsconfig-paths/register src/controller/patron/cli.ts --checkin",
        "patron:referral": "ts-node -r tsconfig-paths/register src/controller/patron/cli.ts --referral",
        "patron:balance": "ts-node -r tsconfig-paths/register src/controller/patron/cli.ts --balance",
        "patron:standing": "ts-node -r tsconfig-paths/register src/controller/patron/cli.ts --standing",
        "patron:whisper": "ts-node -r tsconfig-paths/register src/controller/patron/cli.ts --whisper",
        "patron:bulk-register": "ts-node -r tsconfig-paths/register src/controller/patron/cli.ts --bulk-register",
        "storyteller:dry-run": "ts-node -r tsconfig-paths/register src/controller/storyteller/cli.ts",
        "storyteller:run": "ts-node -r tsconfig-paths/register src/controller/storyteller/run-cli.ts",
        "storyteller:overseer": "ts-node -r tsconfig-paths/register src/controller/storyteller/overseer-cli.ts",
        "ncri:list": "ts-node -r tsconfig-paths/register src/controller/ncri/cli.ts list",
        "ncri:approve": "ts-node -r tsconfig-paths/register src/controller/ncri/cli.ts approve",
        "ncri:price": "ts-node -r tsconfig-paths/register src/controller/ncri/cli.ts price",
        "ncri:seed": "ts-node -r tsconfig-paths/register src/controller/ncri/cli.ts seed",
        "ncri:demo-sale": "ts-node -r tsconfig-paths/register src/controller/ncri/cli.ts demo-sale",
        "city:digest": "ts-node -r tsconfig-paths/register src/controller/city-integration/cli.ts",
        "controller:knowledge:review": "npm run build && node dist/controller/knowledge/review-suggestions.js",
        "simulation": "npm run build && npm run build:simulation && node dist/simulation/index.js",
        "simulation:birth": "npm run build:simulation && node dist/simulation/birth.js",
        "simulation:assign-goals": "npm run build:simulation && node dist/simulation/assign-goals.js",
        "simulation:report": "npm run build:simulation && node dist/simulation/report.js",
        "simulation:dev": "ts-node -r tsconfig-paths/register simulation/index.ts",
        "build": "rimraf dist && swc ./src -d dist --strip-leading-paths",
        "build:simulation": "swc ./simulation -d dist/simulation --strip-leading-paths",
        "build:watch": "swc ./src -d dist -w --strip-leading-paths",
        "lint": "biome lint",
        "lint:fin": "biome lint --write --diagnostic-level=error --reporter=summary",
        "lint:fix": "biome lint --write",
        "format": "biome format",
        "format:fin": "biome format --write --reporter=summary",
        "format:fix": "biome format --write",
        "check:no-ui": "node scripts/check-no-server-ui.js",
        "fin": "npm run check:no-ui && npm run typecheck && npm run lint:fin && npm run format:fin && npm run test:fin",
        "test": "jest",
        "test:fin": "jest --silent --reporters=\"summary\"",
        "typecheck": "tsc -p ./ --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/runejs/server.git"
    },
    "keywords": ["runejs", "runescape", "typescript", "game server", "game engine"],
    "author": "Tynarus",
    "license": "GPL-3.0",
    "bugs": {
        "url": "https://github.com/runejs/server/issues"
    },
    "homepage": "https://github.com/runejs/server#readme",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@runejs/common": "2.0.2-beta.3",
        "@runejs/filestore": "0.17.0",
        "@runejs/login-server": "2.1.0",
        "@runejs/update-server": "1.4.0",
        "execa": "^9.6.1",
        "js-yaml": "^4.1.0",
        "json5": "^2.2.3",
        "lodash": "^4.17.21",
        "quadtree-lib": "^1.0.9",
        "rxjs": "^7.8.1",
        "source-map-support": "^0.5.21",
        "tslib": "^2.8.1",
        "uuid": "^11.0.5",
        "ws": "^8.18.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@biomejs/biome": "1.9.4",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.10.9",
        "@types/jest": "^29.5.14",
        "@types/js-yaml": "^4.0.9",
        "@types/lodash": "^4.17.14",
        "@types/node": "^22.19.19",
        "@types/uuid": "^10.0.0",
        "@types/ws": "^8.5.13",
        "chokidar": "^5.0.0",
        "concurrently": "^9.1.2",
        "jest": "^29.7.0",
        "nodemon": "^3.1.9",
        "rimraf": "^6.0.1",
        "ts-jest": "^29.4.9",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3"
    }
}
