# Copy to .env.local for local benchmarking. Never commit real keys.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# OpenRouter model slugs are intentionally configurable so benchmark runs can
# test new model releases without changing source.
OPENROUTER_HAIKU_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_STORYTELLER_MODEL=anthropic/claude-3.7-sonnet

# Storyteller can use either the OpenRouter aliases above or these explicit
# OpenAI-compatible endpoint vars. A positive daily cap is required before any
# paid Storyteller model request is made.
STORYTELLER_LLM_BASE_URL=
STORYTELLER_LLM_API_KEY=
STORYTELLER_LLM_MODEL=
STORYTELLER_DAILY_COST_CAP_USD=1.00

# Internal city dashboard -> Null City controller API.
# Start with: npm run controller -- --city-http-port 43620 --city-http-token "$CONTROLLER_CITY_HTTP_TOKEN"
CONTROLLER_CITY_HTTP_PORT=
CONTROLLER_CITY_HTTP_HOST=127.0.0.1
CONTROLLER_CITY_HTTP_PATH_PREFIX=/api/nullcity
CONTROLLER_CITY_HTTP_TOKEN=
